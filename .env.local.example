# ---------------------------------------------------------------------------
# Baby Album — environment variables (Phase 1)
# Copy this file to `.env.local` and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- Supabase (project in AWS ap-south-1 / Mumbai) -------------------------
# From Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key: SERVER-ONLY. Bypasses Row-Level Security. Used by the
# image-processing route to read originals and write derivatives.
# Keep it out of any NEXT_PUBLIC_* var. Never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Private storage bucket that holds uploaded photos (create it as PRIVATE).
NEXT_PUBLIC_SUPABASE_PHOTO_BUCKET=album-photos

# --- App config -------------------------------------------------------------
# Public base URL, used to build the magic-link redirect. For local dev this is
# http://localhost:3000 ; in prod set it to your deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hard upload cap. TODO: replace with the real per-theme slot total once the
# finished templates fix it (brief §5/§14, ~55–60). Placeholder for now.
NEXT_PUBLIC_UPLOAD_CAP=56

# Max accepted file size per photo, in megabytes (brief §13 — very large files).
NEXT_PUBLIC_MAX_FILE_MB=25
